# .gitignore pour projet Python
# Ignorer les fichiers compilés, caches et environnements locaux

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/
share/python-wheels/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/

# Type checkers
.mypy_cache/
.pyre/

# Jupyter
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# celery
celerybeat-schedule
celerybeat.pid

# dotenv
.env
.env.*
.env.local
.envrc

# VS Code / IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp

# macOS
.DS_Store

# Windows
Thumbs.db

# Logs
*.log

# Databases
*.sqlite3
*.db

# Compiled files
*.class

# Streamlit
.streamlit/

# Node
node_modules/

# Build artefacts
dist/
build/
*.egg-info/

# Optional: dossiers de données volumineuses
# Si vous souhaitez ignorer les données brutes/traitées, décommentez l'une des lignes ci-dessous
# /data/
# /data/raw/
# /data/processed/

# Fichiers temporaires divers
*.tmp
*.temp

# Coverage / reports
htmlcov/
coverage/

# OS-specific files
ehthumbs.db
Icon?

# End of .gitignore
